      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is playing."
          }
        }
      }
    },
    "%@ çalıştırılabilir bir dosya; güvenlik için açmadım, Finder'da gösterdim.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is an executable file, so for safety I didn't open it. I showed it in Finder instead."
          }
        }
      }
    },
    "%@ özgür yazılımdır: GNU GPL 3.0 koşullarıyla kullanabilir, değiştirebilir ve dağıtabilirsin. Hiçbir garanti verilmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is free software: you can use, modify and distribute it under the terms of the GNU GPL 3.0. It comes with no warranty."
          }
        }
      }
    },
    "%@, %@ adresine \"%@\" konulu e-postayı gönderiyorum%@%@. Göndermem için evet ya da gönder de.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm sending the email \"%3$@\" to %1$@ at %2$@%4$@%5$@. Say yes or send to send it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$@ adresine \"%3$@\" konulu e-postayı gönderiyorum%4$@%5$@. Göndermem için evet ya da gönder de."
          }
        }
      }
    },
    "%@, %@ için iMessage ile %@ dosyasını gönderiyorum. Göndermem için evet ya da gönder de.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm sending %1$@ (%2$@) the file %3$@ by iMessage. Say yes or send to send it."
          }
        }
      }
    },
    "%@, %@ için iMessage ile %@ dosyasını şunu gönderiyorum: %@. Göndermem için evet ya da gönder de.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm sending %1$@ (%2$@) the file %3$@ by iMessage with this message: %4$@. Say yes or send to send it."
          }
        }
      }
    },
    "%@, %@ için iMessage ile gönderiyorum. Göndermem için evet ya da gönder de.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm sending a message to %1$@ (%2$@) by iMessage. Say yes or send to send it."
          }
        }
      }
    },
    "%@, %@ için iMessage ile şunu gönderiyorum: %@. Göndermem için evet ya da gönder de.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm sending %1$@ (%2$@) this by iMessage: %3$@. Say yes or send to send it."
          }
        }
      }
    },
    "%@. Yerel IP adresin %@.": {
