        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A version of OpenAI Whisper adapted for the Mac. The first time you choose it, about 1.5 GB is downloaded and setup takes a few minutes. In our tests it was slower and less accurate (6%, 0.35 s); worth trying for accented speech."
          }
