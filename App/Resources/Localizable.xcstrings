      }
    },
    "%@ gizlendi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is hidden."
          }
        }
      }
    },
    "%@ hata veriyor: %@. İstersen geri al de.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ shows an error: %2$@. Say undo if you want to revert it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ hata veriyor: %2$@. İstersen geri al de."
