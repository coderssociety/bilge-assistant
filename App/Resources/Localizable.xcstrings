{
  "sourceLanguage": "tr",
  "strings": {
    "": {},
    " Bunlar en yenileri, %lld bilgi daha var.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " These are the most recent; there are %lld more."
          }
        }
      }
    },
    " artı ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " plus "
          }
        }
      }
    },
    " bölü ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " divided by "
          }
        }
      }
    },
    " eksi ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " minus "
          }
        }
      }
    },
    " ile ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " to "
          }
        }
      }
    },
    " Öndeki: %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " In front: %@."
          }
        }
      }
    },
    " çarpı ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " times "
          }
        }
      }
    },
    "\"Bilge, eşimin adının Ayşe olduğunu hatırla\" dediğinde bilgi burada görünür.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you say \"Bilge, remember that my partner's name is Ayşe,\" it shows up here."
          }
        }
      }
    },
    "%@ %@ %@ %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ is %3$@ %4$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ %3$@ %4$@."
          }
        }
      }
    },
    "%@ %@ %@ Yapayım mı?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@ Shall I go ahead?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ %3$@ Yapayım mı?"
          }
        }
      }
    },
    "%@ %lld etkinlik var: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ you have %2$lld events: %3$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$lld etkinlik var: %3$@"
          }
        }
      }
    },
    "%@ '%@' adında bir klasör zaten var.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's already a folder named '%2$@' %1$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ '%2$@' adında bir klasör zaten var."
          }
        }
      }
    },
    "%@ '%@' klasörünü oluşturdum.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I created the folder '%2$@' %1$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ '%2$@' klasörünü oluşturdum."
          }
        }
      }
    },
    "%@ LM Studio'da yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn't in LM Studio."
          }
