    },
    "%@ hoş geldin": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to %@"
          }
        }
      }
    },
    "%@ hücresine %@ formülünü yazayım mı?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shall I put the formula %2$@ in cell %1$@?"
