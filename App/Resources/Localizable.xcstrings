    "Sesin %@ tarihinde kaydedildi. Televizyon ya da odadaki başkaları komut veremez ve onay veremez; “%@, dur” herkese açıktır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice was saved on %1$@. The TV or other people in the room can't give commands or confirmations; anyone can say “%2$@, stop”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "Sesin %1$@ tarihinde kaydedildi. Televizyon ya da odadaki başkaları komut veremez ve onay veremez; “%2$@, dur” herkese açıktır."
          }
        }
      }
    },
    "Sesin kaydedildi": {
