          "stringUnit": {
            "state": "new",
            "value": "%1$@ için '%2$@' etkinliğini takvime ekleyeyim mi?"
          }
        }
      }
    },
    "%@ için kayıtlı bir e-posta adresi bulamadım.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't find a saved email address for %@."
