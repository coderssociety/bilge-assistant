    },
    "İndirilenler'de": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "in Downloads"
          }
        }
      }
    },
    "İndirilenler'de okunabilir bir belge bulamadım.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't find a readable document in Downloads."
          }
        }
      }
    },
    "İndirme yok · sistemle gelir": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No download · built into macOS"
          }
        }
      }
    },
    "İniyor · %%%lld · bitene kadar Apple modeli yanıt verir": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading · %lld%% · the Apple model answers until it's done"
          }
        }
      }
    },
    "İptal edilecek zamanlayıcı yoktu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There was no timer to cancel."
          }
        }
      }
    },
    "İsveç kronu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swedish krona"
          }
        }
      }
    },
    "İsviçre frangı": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swiss franc"
          }
        }
      }
    },
    "İzin reddedildi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permission denied"
          }
        }
      }
    },
    "İzin ver": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow"
          }
        }
      }
    },
    "İzin verildi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed"
          }
        }
      }
    },
    "İzinler": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions"
          }
        }
      }
    },
    "İzinler yalnızca istediğin işler için kullanılır. Bir izni geri almak için Sistem Ayarları > Gizlilik ve Güvenlik.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissions are used only for the tasks you ask for. To revoke a permission, go to System Settings > Privacy & Security."
          }
        }
      }
    },
    "İzleme Dörtgeni": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trackpad"
          }
        }
      }
    },
    "Şehir": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "City"
          }
        }
      }
    },
    "Şehir söylemediğinde hava durumu bu şehir için verilir. Şehir adı Open-Meteo'ya gönderilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you don't name a city, you get the weather for this one. The city name is sent to Open-Meteo."
          }
        }
      }
    },
    "Şu an çalan bir şey yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is playing right now."
          }
        }
      }
    },
    "Şunları dene:": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try these:"
          }
        }
      }
    },
    "Şunu duydum: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I heard: %@"
          }
        }
      }
    },
    "Şunu hatırlayayım mı: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shall I remember this: %@"
          }
        }
      }
    },
    "şarj oluyor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "charging"
          }
        }
      }
    },
    "“%@, %@”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@, %2$@”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "“%1$@, %2$@”"
          }
        }
      }
    },
    "“%@”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”"
          }
        }
      }
    },
    "“%@” dediğinde uyanır, öncesini dinlemez ve kaydetmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wakes when you say “%@”; it doesn't listen to or record anything before that."
          }
        }
      }
    },
    "“%@” dediğinde yüklenmeye başlar, sen konuşurken büyük ölçüde hazır olur (Qwen ~4 sn, Gemma ~6 sn). Yanıt bitip devam sorusu gelmezse bellekten çıkar. Gecikirse “Bir saniye” der.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts loading when you say “%@” and is mostly ready while you're still talking (Qwen ~4 s, Gemma ~6 s). It's unloaded from memory once the reply ends and no follow-up comes. If it's slow, it says “One moment.”"
          }
        }
      }
    },
    "“Ahmet'in numarasını bul ve ona mesaj at” gibi birbirine bağlı işleri planlayamaz, parçaları ayrı ayrı yapar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't plan linked tasks like “find Ahmet's number and text him”; it does each part separately"
          }
        }
      }
    },
    "“Ekranda ne yazıyor?” için. Görüntü kaydedilmez, sadece okunur.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For “What does the screen say?”. The image is only read, never saved."
          }
        }
      }
    },
    "… (devamı var).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "… (there's more)."
          }
        }
      }
    },
    "Qwen 3.8'in bir önceki sürümü.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous version of Qwen 3.8."
          }
        }
      }
    },
    "Türkçe genel bilgide güçlü, cevabı hızlı üretir. Testlerimizde en iyi sonuç veren model ailesi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strong on Turkish general knowledge and quick to answer. The best model family in our tests."
          }
        }
      }
    },
    "Google'ın büyük Gemma 4 modeli; Türkçe genel bilgide güçlü, ilk kelimeye çabuk başlar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google's large Gemma 4 model. Strong on Turkish general knowledge and quick to start answering."
          }
        }
      }
    },
    "config.json yok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no config.json"
          }
        }
      }
    },
    ".safetensors dosyası yok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no .safetensors file"
          }
        }
      }
    },
    "tokenizer dosyası yok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no tokenizer file"
          }
        }
      }
    },
    "config.json'da model_type yok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no model_type in config.json"
          }
        }
      }
    },
    "JANG biçimi yalnızca vMLX'te çalışır": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the JANG format only runs in vMLX"
          }
        }
      }
    },
    "Hugging Face önbelleği": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face cache"
          }
        }
      }
    },
    "Ekle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add"
          }
        }
      }
    },
    "MLX modellerinin bulunduğu klasörü seç.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder that contains MLX models."
          }
        }
      }
    },
    "Bu Mac'te MLX modeli bulunamadı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No MLX models found on this Mac."
          }
        }
      }
    },
    "Bu Mac'teki modeller": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Models on this Mac"
          }
        }
      }
    },
    "Klasör ekle…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Folder…"
          }
        }
      }
    },
    "LM Studio'nun, Hugging Face önbelleğinin ve eklediğin klasörlerin içindeki MLX modelleri. Kopyalanmaz, bulundukları yerden uygulamanın içinde çalışır; LM Studio'nun açık olması gerekmez. GGUF modeller burada görünmez. Desteklenmeyen bir model türü açılamazsa cevabı Apple modeli verir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MLX models in LM Studio, the Hugging Face cache and folders you added. They aren't copied: they run inside the app from where they are, and LM Studio doesn't need to be open. GGUF models aren't shown here. If a model type isn't supported, Apple's model answers instead."
          }
        }
      }
    },
    "Kaldır": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove"
          }
        }
      }
    },
    "Bir modeli Bilge'nin kendi klasörüne de koyabilirsin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also put a model in Bilge's own folder."
          }
        }
      }
    },
    "Bilge'nin klasörünü aç": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Bilge's Folder"
          }
        }
      }
    },
    "%@ · tür: %@%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · type: %2$@%3$@"
          }
        }
      }
    },
    "%@ başka bir uygulamada kullanılıyor; başka bir kısayol seç.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app already uses %@; choose another shortcut."
          }
        }
      }
    },
    "%@ güncel (%@).": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ güncel (%2$@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is up to date (%2$@)."
          }
        }
      }
    },
    "Denetlenemedi: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't check: %@"
          }
        }
      }
    },
    "Dinleme kısayolu": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening shortcut"
          }
        }
      }
    },
    "GitHub %lld yanıtını verdi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub answered %lld."
          }
        }
      }
    },
    "Güncellemeler": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates"
          }
        }
      }
    },
    "Kapatmak için önce bir dinleme kısayolu seç.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a listening shortcut before turning this off."
          }
        }
      }
    },
    "Kısayol kaydedilemedi (%d).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't register the shortcut (%d)."
          }
        }
      }
    },
    "Kısayol yok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No shortcut"
          }
        }
      }
    },
    "Kısayola basınca %@ adını duymuş gibi dinler; konuşurken basarsan susar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressing the shortcut makes %@ listen as if you said its name; pressing it while it speaks stops it."
          }
        }
      }
    },
    "Kısayolu bekliyor (%@)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the shortcut (%@)"
          }
        }
      }
    },
    "Temizle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear"
          }
        }
      }
    },
    "Tuşlara bas…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press the keys…"
          }
        }
      }
    },
    "Yeni sürüm var: %@ %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "Yeni sürüm var: %1$@ %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new version is out: %1$@ %2$@"
          }
        }
      }
    },
    "Yeni sürüm: %@ %@…": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "Yeni sürüm: %1$@ %2$@…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New version: %1$@ %2$@…"
          }
        }
      }
    },
    "Yeni sürümleri denetle (günde bir kez GitHub'a bakar)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check for new versions (looks at GitHub once a day)"
          }
        }
      }
    },
    "Şimdi denetle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
