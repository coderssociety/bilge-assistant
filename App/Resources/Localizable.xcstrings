    "%@ duraklatıldı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is paused."
          }
        }
      }
    },
    "%@ erişim izni yok. Sistem Ayarları > Gizlilik ve Güvenlik bölümünden izin verilmeli.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No access to %@. You need to allow it in System Settings > Privacy & Security."
          }
