    "%@ dolu, içinde %@ var. Üzerine yazayım mı?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ already contains %2$@. Shall I overwrite it?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ dolu, içinde %2$@ var. Üzerine yazayım mı?"
