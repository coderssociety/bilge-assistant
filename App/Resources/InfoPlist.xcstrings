    },
    "NSAppleEventsUsageDescription" : {
      "comment" : "Privacy - AppleEvents Sending Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilge uses Apple Events to control apps at your request (Music, Notes, Mail, Messages, your browser). Anything that sends a message always waits for your approval."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bilge, senin isteğinle uygulamaları kontrol etmek (müzik, notlar, Mail, Mesajlar, tarayıcı) için Apple Events kullanır. Gönderme işlemleri her zaman onayınla yapılır."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilge accesses Bluetooth to turn it on or off and tell you whether it is on, when you ask."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bilge, istediğinde Bluetooth'u açıp kapatmak ve açık olup olmadığını söylemek için Bluetooth'a erişir."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilge accesses your calendar to read your events and, with your approval, add new ones."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bilge, takvimindeki etkinlikleri okumak ve senin onayınla yenilerini eklemek için takvime erişir."
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Privacy - Contacts Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilge accesses your contacts to find someone's phone number or email when you ask, and to send messages with your approval."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bilge, sorduğunda birinin telefonunu ya da e-postasını bulmak ve senin onayınla mesaj göndermek için kişilerine erişir."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilge uses the local network only to send smart-home commands to the Home Assistant address you enter in Settings."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bilge, akıllı ev komutlarını yalnızca ayarlarda girdiğin Home Assistant adresine göndermek için yerel ağa erişir."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilge uses the microphone to hear the wake word and your commands. Audio is never stored and never leaves your Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bilge, uyandırma kelimesini ve komutlarını duymak için mikrofonu kullanır. Ses kaydı saklanmaz ve Mac'inden dışarı çıkmaz."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "comment" : "Privacy - Reminders Full Access Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilge accesses your reminders to read them and, with your approval, add new ones."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bilge, anımsatıcılarını okumak ve senin onayınla yenilerini eklemek için anımsatıcılara erişir."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilge uses speech recognition to transcribe your voice commands on your device."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Bilge, Türkçe komutlarını cihaz üzerinde yazıya dökmek için konuşma tanımayı kullanır."
          }
        }
      }
    }
  },
  "version" : "1.0"
}