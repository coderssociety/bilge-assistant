{
  "sourceLanguage": "tr",
  "strings": {
    "": {},
    " Bunlar en yenileri, %lld bilgi daha var.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " These are the most recent; there are %lld more."
          }
        }
      }
    },
    " artı ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " plus "
          }
        }
      }
    },
    " bölü ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " divided by "
          }
        }
      }
    },
    " eksi ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " minus "
          }
        }
