    "%@ podcastinin son bölümü %@ yayınlandı: %@. O zamandan beri yeni bölüm yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest episode of %1$@ came out %2$@: %3$@. There hasn't been a new one since."
