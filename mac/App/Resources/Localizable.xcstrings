            "state": "translated",
            "value": "No file name was given to search for."
          }
        }
      }
    },
    "Arka arkaya konuşmalarda yeniden yüklemeyi bekletmez; süre dolunca bellekten çıkar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reload wait between back-to-back conversations; it's unloaded from memory when the time runs out."
