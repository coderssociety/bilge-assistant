      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shall I delete this routine: %1$@, “%2$@”?"
          }
        }
      }
    },
    "%@, %@ adresinden gelen \"%@\" konulu e-postaya şu yanıtı gönderiyorum: %@. Göndermem için evet ya da gönder de.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm replying to the e-mail \"%3$@\" from %1$@, %2$@, with: %4$@. Say yes or send to send it."
          }
        }
      }
    },
    "%@, %@ adresine \"%@\" konulu e-postayı gönderiyorum%@%@. Göndermem için evet ya da gönder de.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm sending the email \"%3$@\" to %1$@ at %2$@%4$@%5$@. Say yes or send to send it."
          }
        },
        "tr": {
