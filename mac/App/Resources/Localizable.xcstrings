      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " times "
          }
        }
      }
    },
    "\"Bilge, eşimin adının Ayşe olduğunu hatırla\" dediğinde bilgi burada görünür.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you say \"Bilge, remember that my partner's name is Ayşe,\" it shows up here."
          }
        }
      }
    },
    "\"Bilge, her gece 21'de hava durumunu söyle\" dediğinde rutin burada görünür.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Routines you set up by saying \"Bilge, every night at 9 tell me the weather\" appear here."
          }
        }
      }
    },
    "%@ '%@' açılamadı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't open '%2$@' %1$@."
          }
        }
      }
    },
    "%@ '%@' açıldı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opened '%2$@' %1$@."
          }
        }
      }
    },
    "%@ '%@' için bir şarkı bulamadım; arama sayfasını açtım.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't find a song for '%2$@' %1$@, so I opened its search page."
