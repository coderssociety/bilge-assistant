    "Bilge seni bu dilde dinler, bu dilde konuşur ve menüleri bu dilde gösterir.\nBilge listens, speaks and shows its menus in this language.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilge listens to you, speaks and shows its menus in this language.\nBilge seni bu dilde dinler, bu dilde konuşur ve menüleri bu dilde gösterir."
          }
        }
      }
    },
    "Bilge yalnızca kendi yüklediği modeli kapatır; LM Studio'da ya da vMLX'te senin açtığın modele dokunmaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilge only unloads models it loaded itself; it never touches a model you opened in LM Studio or vMLX."
          }
        }
      }
    },
    "Bilge, Ahmet'e geç kalacağımı yaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilge, text Ahmet that I'll be late."
          }
        }
      }
    },
    "Bilge, bugün takvimimde ne var?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilge, what's on my calendar today?"
          }
        }
      }
    },
    "Bilge, müziği biraz kıs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilge, turn the music down a bit."
          }
        }
      }
    },
    "Bilge, saat kaç?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilge, what time is it?"
          }
        }
      }
    },
    "Bilge, yarın hava nasıl olacak?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilge, what's the weather tomorrow?"
          }
