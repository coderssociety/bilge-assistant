    },
    "Arama başlatılamadı. FaceTime'ın ve iPhone'dan arama ayarının açık olduğunu kontrol et.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't start the call. Check that FaceTime and calls from iPhone are turned on."
