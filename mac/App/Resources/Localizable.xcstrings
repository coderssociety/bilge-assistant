        }
      }
    },
    "%@ şarkıyı arayamadım; '%@' arama sayfasını açtım.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't search %1$@, so I opened the search page for '%2$@'."
