          }
        }
      }
    },
    "OpenAI, Anthropic, Google Gemini, OpenRouter, Groq ve DeepSeek senin API anahtarınla; Ollama ve llama.cpp Mac'inde çalışan sunucudan.": {
      "localizations": {
        "en": {
