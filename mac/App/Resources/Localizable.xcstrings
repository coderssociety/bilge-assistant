        }
      }
    },
    "Uygulama açıkken iki dakikada bir AFAD'a bakar; hava durumu şehrine 150 km içindeki 4 ve üzeri depremleri bir kez söyler ve bildirim gösterir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the app is open, it checks AFAD every two minutes and announces each earthquake of magnitude 4 or more within 150 km of the weather city once, with a notification."
          }
        }
      }
