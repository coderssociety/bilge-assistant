    "Asistanın sesi": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assistant's voice"
          }
        }
      }
    },
    "Asistanın yaptığı ve onay bekleyen işler burada listelenir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Things the assistant has done and actions waiting for your approval are listed here."
