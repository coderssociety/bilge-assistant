      }
    },
    "Bilgiler yalnızca bu Mac'te saklanır.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This information is stored only on this Mac."
          }
        }
      }
    },
    "bir ağa bağlı değil": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "not connected to a network"
          }
        }
      }
    },
    "bir ağa bağlı; ağın adını macOS yalnızca Konum izni olan uygulamalara söylüyor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "connected to a network; macOS only tells apps with Location access its name"
          }
        }
      }
    },
    "Bir etkinlik": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An event"
          }
        }
      }
    },
    "Bir rutin var: %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is one routine: %@."
          }
        }
      }
    },
    "Bir rutinin komutu başka bir rutin olamaz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A routine's command can't be another routine."
          }
        }
      }
    },
    "Bir saniye. ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One moment. "
          }
        }
      }
    },
    "Birden fazla etkinlik uyuyor: %@. Hangisi olduğunu günüyle ya da saatiyle söyler misin?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than one event fits: %@. Which one is it? Tell me its day or time."
          }
        }
      }
    },
    "Birden fazla rutin var: %@. Hangisini sileyim?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are several routines: %@. Which one shall I delete?"
          }
        }
      }
    },
    "Birinin numarasını ya da e-postasını bulmak ve onayınla mesaj göndermek için.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To find someone's number or email and send messages with your approval."
          }
        }
      }
    },
    "Bluetooth açık.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is on."
          }
        }
      }
    },
    "Bluetooth açıldı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is now on."
          }
        }
      }
    },
    "Bluetooth değişmedi. Sistem Ayarları > Gizlilik ve Güvenlik > Bluetooth'ta Bilge'ye izin verilmiş olmalı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth didn't change. Bilge needs permission in System Settings > Privacy & Security > Bluetooth."
          }
        }
      }
    },
    "Bluetooth kapalı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is off."
          }
        }
      }
    },
    "Bluetooth kapatıldı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is now off."
          }
        }
      }
    },
    "Bluetooth zaten açık.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is already on."
          }
        }
      }
    },
    "Bluetooth zaten kapalı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is already off."
          }
        }
      }
    },
    "Bluetooth'u bu macOS sürümünde kontrol edemiyorum.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't control Bluetooth on this version of macOS."
          }
        }
      }
    },
    "Bluetooth'u kapatırsam Bluetooth klavye, fare ve kulaklıkların bağlantısı kesilir. Kapatayım mı?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If I turn Bluetooth off, Bluetooth keyboards, mice and headphones will disconnect. Turn it off?"
          }
        }
      }
    },
    "Borsa verisi alınamadı. %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't get stock market data. %@"
          }
        }
      }
    },
    "Bu ay": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This month"
          }
        }
      }
    },
    "Bu dosyada ses yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file has no audio."
          }
        }
      }
    },
    "Bu ekranın parlaklığını Mac'ten değiştiremiyorum; harici ekranlarda ekranın kendi düğmelerini kullanman gerekiyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't change this display's brightness from the Mac; on an external display, use the display's own buttons."
          }
        }
      }
    },
    "Bu işlem yalnızca sesli komutla yapılabilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can only be done by voice command."
          }
        }
      }
    },
    "Bu Mac'in belleği bu model için yetmez.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac doesn't have enough memory for this model."
          }
        }
      }
    },
    "Bu Mac'in belleği için büyük olabilir.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This may be too large for this Mac's memory."
          }
        }
      }
    },
    "Bu Mac'te %@ çalışıyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac is running %@."
          }
        }
      }
    },
    "Bu Mac'te %lld GB bellek var.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has %lld GB of memory."
          }
        }
      }
    },
    "Bu Mac'te Wi-Fi bulunamadı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Wi-Fi was found on this Mac."
          }
        }
      }
    },
    "Bu Mac'te pil yok, prize bağlı çalışıyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac has no battery; it runs on power from the outlet."
          }
        }
      }
    },
    "Bu Mac'te seçili dilde dikte desteklenmiyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictation isn't supported in the selected language on this Mac."
          }
        }
      }
    },
    "Bu Mac, Apple'ın cihaz içi dil modelini desteklemiyor.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac doesn't support Apple's on-device language model."
          }
        }
      }
    },
    "Bu adla klasör oluşturamam.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't create a folder with that name."
          }
        }
      }
    },
    "Bu adresi açamam.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't open that address."
          }
        }
      }
    },
    "Bu aralık sesle hesaplamak için çok büyük.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That range is too big to calculate by voice."
          }
        }
      }
    },
    "Bu bilgiyi sil": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete This Memory"
          }
        }
      }
    },
    "Bu hatırlamak için fazla uzun, daha kısa söyler misin?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's too long to remember. Could you say it more briefly?"
          }
        }
      }
    },
    "Bu isteğe yardımcı olamıyorum.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't help with that request."
          }
        }
      }
    },
    "Bu isteği adım adım tamamlayamadım.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't complete that request step by step."
          }
        }
      }
    },
    "Bu işlem için onay gerekiyor ama şu an onay alamıyorum, bu yüzden yapmadım.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This needs your approval, but I can't ask for it right now, so I didn't do it."
          }
        }
      }
    },
    "Bu kur bulunamadı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't find that currency."
          }
        }
      }
    },
    "Bu pencere tam ekran yapılamadı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This window can't go full screen."
          }
        }
      }
    },
    "Bu pencere taşınamadı ya da boyutlandırılamadı.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This window couldn't be moved or resized."
          }
        }
      }
    },
    "Bu pencerede %lld sekme var.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This window has %lld tabs."
          }
        }
      }
    },
    "Bu rutindeki “%@” adımı senin onayını gerektiriyor; sen yokken yapmadım. Buradayken söylemen yeterli.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The “%@” step of this routine needs your yes, so I didn't do it while you were away. Just ask me when you're here."
          }
        }
      }
    },
    "Bu rutini sil": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this routine"
          }
        }
      }
    },
    "Bu sembol için veri yok.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no data for this symbol."
          }
        }
      }
    },
    "Bu ses dosyasını okuyamadım.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't read this audio file."
          }
        }
      }
    },
    "Bu tarayıcıda sekmelere adıyla geçemiyorum.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
