        }
      }
    },
    "Apple Music'te '%@' gösterildi; çalmak için oynat düğmesine basabilirsin.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' is shown in Apple Music; press play to hear it."
